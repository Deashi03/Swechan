     "defJa": "{誰|だれ}かが{行|い}けないように、または{遅|おく}れるようにする。",
     "concept": false,
     "examples": [
      {
       "sv": "Jag ska inte uppehålla dig längre.",
       "ja": "これ{以上|いじょう}お{引|ひ}き{止|と}めしません。"
