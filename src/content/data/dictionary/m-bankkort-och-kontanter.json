   "senses": [
    {
     "id": "s.täckning.1",
     "ja": "（{口座|こうざ}の）{残高|ざんだか}、{支払|しはら}い{能力|のうりょく}",
     "defSv": "När det finns tillräckligt med pengar för att betala.",
     "defJa": "{払|はら}うのに{十分|じゅうぶん}なお{金|かね}があること。",
     "concept": false,
     "examples": [
      {
       "sv": "Det finns ingen täckning på kortet.",
       "ja": "カードの{残高|ざんだか}が{足|た}りません。"
      }
     ],
     "tags": [
      "handel",
      "pengar"
     ],
     "quality": {
      "status": "ai-draft"
     },
     "explanation": {
      "sv": "Täckning betyder att det finns tillräckligt med pengar på kontot för att betala. Om det står ”ingen täckning” kan man inte betala med kortet. Ordet kan också betyda att mobilen fungerar på ett ställe.",
      "ja": "「täckning」は、{支払|しはら}いに{十分|じゅうぶん}なお{金|かね}が{口座|こうざ}にあることです。「{残高不足|ざんだかぶそく}」と{出|で}たら、カードで{払|はら}えません。{携帯|けいたい}の{電波|でんぱ}が{届|とど}くという{意味|いみ}もあります。"
     }
    }
   ]
