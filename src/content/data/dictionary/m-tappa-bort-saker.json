  {
   "id": "e.vända-upp-och-ner-på",
   "lemma": "vända upp och ner på",
   "pos": "verb",
   "level": "B2",
   "inflection": {
    "kind": "verb",
    "infinitive": "vända upp och ner på",
    "present": "vänder upp och ner på",
    "past": "vände upp och ner på",
    "supine": "vänt upp och ner på",
    "imperative": "vänd upp och ner på",
    "group": "2"
   },
   "senses": [
    {
     "id": "s.vända-upp-och-ner-på.1",
     "ja": "ひっくり{返|かえ}す（ように{探|さが}す）",
     "defSv": "Leta så att allt hamnar på fel plats.",
     "defJa": "すべてが{散|ち}らかるほど{探|さが}し{回|まわ}る。",
     "concept": false,
     "examples": [
      {
       "sv": "Vi vände upp och ner på hela huset.",
       "ja": "{家中|いえじゅう}をひっくり{返|かえ}して{探|さが}しました。"
      }
     ],
     "labelSv": "leta",
     "frame": {
      "subject": "Hon",
      "complement": "rummet"
     },
     "tags": [
      "vardag",
      "problem"
     ],
     "quality": {
      "status": "ai-draft"
     },
     "explanation": {
      "sv": "Att vända upp och ner på ett rum betyder att man letar så noga att allt hamnar på fel plats och det blir stökigt. Man kan också vända upp och ner på någons liv, alltså ändra allt.",
      "ja": "「vända upp och ner på」は、すべてがめちゃくちゃになるほど{部屋|へや}を{徹底的|てっていてき}に{探|さが}すことです。{誰|だれ}かの{生活|せいかつ}を「ひっくり{返|かえ}す」、つまりすっかり{変|か}えるという{意味|いみ}もあります。"
     }
    },
    {
     "id": "s.vända-upp-och-ner-på.2",
     "ja": "（{生活|せいかつ}などを）{一変|いっぺん}させる",
     "defSv": "Förändra något helt, så att ingenting blir som förut.",
     "defJa": "{何|なに}もかも{前|まえ}と{同|おな}じではなくなるほど、すっかり{変|か}えてしまう。",
     "concept": false,
     "examples": [
      {
       "sv": "Barnet vände upp och ner på hela deras liv.",
       "ja": "{子|こ}どもが{生|う}まれて、{二人|ふたり}の{生活|せいかつ}はすっかり{変|か}わりました。"
      }
     ],
     "labelSv": "förändra helt",
     "explanation": {
      "sv": "Att vända upp och ner på något betyder här att man förändrar det helt. Man säger att en flytt, en sjukdom eller ett barn vänder upp och ner på livet, vardagen eller planerna. Det kan vara något bra eller något dåligt, men det blir alltid stora förändringar.",
      "ja": "ここでの「vända upp och ner på」は、{何|なに}かをすっかり{変|か}えてしまうことです。{引|ひ}っ{越|こ}し、{病気|びょうき}、{子|こ}どもの{誕生|たんじょう}などが、{生活|せいかつ}や{日常|にちじょう}、{計画|けいかく}を「ひっくり{返|かえ}す」と{言|い}います。よいことにも{悪|わる}いことにも{使|つか}いますが、いつも{大|おお}きな{変化|へんか}を{表|あらわ}します。"
     },
     "tags": [
      "motgångar",
      "förändring",
      "känslor"
     ],
     "quality": {
      "status": "ai-draft"
     }
    }
   ]
