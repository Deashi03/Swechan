   "senses": [
    {
     "id": "s.slant.1",
     "ja": "{硬貨|こうか}、{小銭|こぜに}",
     "defSv": "Ett mynt (vardagligt).",
     "defJa": "{硬貨|こうか}（くだけた{言|い}い{方|かた}）。",
     "concept": false,
     "examples": [
      {
       "sv": "Hon har inte en slant kvar.",
       "ja": "{彼女|かのじょ}は{一銭|いっせん}も{残|のこ}っていません。"
      }
     ],
     "register": "informal",
     "tags": [
      "handel",
      "pengar"
     ],
     "quality": {
      "status": "ai-draft"
     },
     "explanation": {
      "sv": "En slant är ett vardagligt ord för ett mynt eller lite pengar. ”Inte en slant” betyder inga pengar alls. Man kan också säga att något kostar en slant, alltså ganska mycket.",
      "ja": "「slant」は{硬貨|こうか}や{少|すこ}しのお{金|かね}のくだけた{言|い}い{方|かた}です。「inte en slant」は「{一銭|いっせん}もない」という{意味|いみ}です。「kosta en slant」は「けっこうお{金|かね}がかかる」という{意味|いみ}になります。"
     }
    }
   ]
