     "defJa": "{住|す}まいを{買|か}うことに{興味|きょうみ}のある{人|ひと}。",
     "concept": false,
     "examples": [
      {
       "sv": "Det kom trettio spekulanter på visningen.",
       "ja": "{内覧|ないらん}に{購入希望者|こうにゅうきぼうしゃ}が30{人|にん}{来|き}ました。"
      }
     ],
     "tags": [
      "hemmet",
      "ekonomi"
     ],
     "quality": {
      "status": "ai-draft"
     },
     "explanation": {
      "sv": "När en bostad säljs i Sverige kommer många och tittar på visningen. De som funderar på att köpa kallas spekulanter. Ofta vill flera spekulanter köpa samma bostad, och då kan priset bli högre.",
      "ja": "スウェーデンで{住宅|じゅうたく}が{売|う}りに{出|だ}されると、{内覧会|ないらんかい}にたくさんの{人|ひと}が{来|き}ます。{買|か}おうか{考|かんが}えている{人|ひと}を「spekulant」と{言|い}います。{何人|なんにん}もが{同|おな}じ{家|いえ}を{欲|ほ}しがり、{値段|ねだん}が{上|あ}がることがよくあります。"
     }
    }
